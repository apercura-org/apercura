{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.next",
			"!**/.turbo",
			"!**/dist",
			"!**/coverage",
			"!**/next-env.d.ts",
			"!packages/db/drizzle/meta"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"@apercura/core/crypto": "Patient data is encrypted and decrypted only in apps/web/src/server/phi (which audits every decryption): import from ~/server/phi instead."
						},
						"patterns": [
							{
								"group": ["**/core/src/crypto", "**/core/src/crypto/**"],
								"message": "Patient data is encrypted and decrypted only in apps/web/src/server/phi: import from ~/server/phi instead."
							}
						]
					}
				}
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"apps/web/src/server/phi/**",
				"apps/web/src/server/crypto/**",
				"packages/core/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		}
	]
}
