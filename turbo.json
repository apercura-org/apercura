{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "stream",
	"globalDependencies": [".env"],
	"globalEnv": ["NODE_ENV", "SKIP_ENV_VALIDATION"],
	"globalPassThroughEnv": [
		"APP_URL",
		"DATABASE_URL*",
		"BETTER_AUTH_*",
		"PSC_*",
		"ENCRYPTION_*",
		"BLIND_INDEX_KEY",
		"ALTCHA_HMAC_KEY",
		"SMTP_URL",
		"MAIL_FROM",
		"S3_*",
		"JOBS_SECRET",
		"REVALIDATE_SECRET",
		"TRUSTED_PROXY_COUNT",
		"ETL_*",
		"FEATURE_BOOKING",
		"PORT",
		"RATE_LIMIT_KEY",
		"CANONICAL_HOST_REDIRECT",
		"DATABASE_POOL_MAX"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["NEXT_PUBLIC_*", "PUBLIC_HDS_HOST", "DATABASE_URL", "APP_URL"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			"outputs": []
		},
		"check": {}
	}
}
