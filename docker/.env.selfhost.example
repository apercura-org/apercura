# Environment of docker/compose.selfhost.yml. Copy it, fill it in, keep the copy private:
#
#   cp docker/.env.selfhost.example docker/.env.selfhost
#   chmod 600 docker/.env.selfhost
#
# Secrets: `bun run keys:generate` (with Bun installed) or, once the image is built,
# `docker run --rm apercura:local keys` prints every value marked "keys" below. Database and
# storage passwords go into connection URLs: use letters and digits only, e.g.
# `openssl rand -hex 24`. Every variable is described in docs/configuration.md.

# --- Public address -----------------------------------------------------------------------
# Origin visitors use, behind your reverse proxy. Baked into static pages at build time:
# rebuild (`up -d --build`) after changing it.
APP_URL=https://annuaire.example.org
# Host side of the app's port. The app only listens on 127.0.0.1: your reverse proxy
# (Caddy, nginx, Traefik) on the same machine terminates TLS and forwards to it.
APP_BIND=127.0.0.1
APP_PORT=3000
# Number of reverse proxies in front of the app (1 for a single Caddy/nginx). 0 only if the
# app is reached directly, which shares one rate-limit bucket between every visitor.
TRUSTED_PROXY_COUNT=1

# --- Database (PostgreSQL 17 + PostGIS) ----------------------------------------------------
# Superuser of the database container: used only by the migrations.
POSTGRES_PASSWORD=
# Login roles created on the first start (docker/postgres/10-apercura-roles.sh).
APERCURA_APP_DB_PASSWORD=
APERCURA_ETL_DB_PASSWORD=
# Optional: leave empty to keep apercura_readonly without login.
APERCURA_READONLY_DB_PASSWORD=
DATABASE_POOL_MAX=10

# --- Secrets (keys) ------------------------------------------------------------------------
BETTER_AUTH_SECRET=
# Application-level encryption: `version:base64key`, comma-separated. Keep old versions listed
# after a rotation; ENCRYPTION_ACTIVE_KEY is the one used for new data.
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY=1
BLIND_INDEX_KEY=
ALTCHA_HMAC_KEY=
RATE_LIMIT_KEY=
REVALIDATE_SECRET=
JOBS_SECRET=

# --- Email ----------------------------------------------------------------------------------
# Your SMTP provider: smtp://user:password@host:587 (URL-encode special characters).
# smtp://mailpit:1025 only works with the `dev` profile (Mailpit, nothing leaves the machine).
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=Apercura <no-reply@annuaire.example.org>
MAILPIT_UI_PORT=8025

# --- File storage (MinIO in the stack, or any S3) ----------------------------------------
MINIO_ROOT_USER=apercura-admin
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://minio:9000
S3_BUCKET=apercura
# The app's own access key, limited to S3_BUCKET (created by minio-init).
S3_ACCESS_KEY_ID=apercura-app
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# Leave empty: the app serves photos itself from /media/photos/….
S3_PUBLIC_URL=

# --- Features -----------------------------------------------------------------------------
# true enables online booking (health data: read the HDS note of docs/self-hosting.md).
FEATURE_BOOKING=false
FEATURE_CLAIM_DOCUMENTS=true
# Name of the HDS-certified host the data really runs on. Leave empty when self-hosting.
PUBLIC_HDS_HOST=
CANONICAL_HOST_REDIRECT=true

# --- Pro Santé Connect (optional, all three or none) --------------------------------------
PSC_CLIENT_ID=
PSC_CLIENT_SECRET=
PSC_ISSUER=

# --- Open data import ---------------------------------------------------------------------
ETL_PROFESSIONS=10,40,50,60
# Scope of the weekly import of the scheduler, e.g. --department 75. Empty: all of France.
ETL_SCHEDULE_ARGS=

# --- Optional ------------------------------------------------------------------------------
# MapLibre style URL (build time). Empty: OpenFreeMap positron.
NEXT_PUBLIC_MAP_STYLE_URL=
# Tag of the image the stack builds and runs.
APERCURA_IMAGE=apercura:local
