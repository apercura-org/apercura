{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2023"],
		"jsx": "react-jsx",
		"types": ["node"],
		// The cache handlers are plain JavaScript (Next.js loads them as they are): checked too.
		"allowJs": true,
		"checkJs": true,
		"plugins": [{ "name": "next" }],
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		"cache-handler/**/*.mjs",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules", ".next/standalone"]
}
