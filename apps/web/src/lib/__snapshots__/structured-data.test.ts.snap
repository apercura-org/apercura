exports[`page entities > links the home page, the website and its search action 1`] = `
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@id": "https://apercura.example/#website",
      "@type": "WebSite",
      "description": "Annuaire ouvert.",
      "inLanguage": "fr-FR",
      "name": "Apercura",
      "potentialAction": {
        "@type": "SearchAction",
        "query-input": "required name=search_term_string",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://apercura.example/recherche?quoi={search_term_string}",
        },
      },
      "publisher": {
        "@id": "https://apercura.example/#organization",
      },
      "url": "https://apercura.example/",
    },
    {
      "@id": "https://apercura.example/#organization",
      "@type": "Organization",
      "logo": {
        "@type": "ImageObject",
        "height": "512",
        "url": "https://apercura.example/icon/512",
        "width": "512",
      },
      "name": "Apercura",
      "sameAs": [
        "https://github.com/maxgfr/apercura",
      ],
      "url": "https://apercura.example/",
    },
  ],
}
`;

