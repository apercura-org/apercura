# Copy to `.env` at the repository root: cp .env.example .env
# Generate secrets with: bun run keys:generate

# --- Application ---------------------------------------------------------------
# Public base URL of the web app (used for links in emails, redirects, SEO).
APP_URL=http://localhost:3000

# --- Database (PostgreSQL + PostGIS) -----------------------------------------
# Runtime connection used by the web app (least-privileged role in production).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/apercura
# Connection used by the open data import. In production use the `apercura_etl` role
# (created by the migrations, `directory` schema only); see docs/data-import.md.
DATABASE_URL_ETL=postgres://postgres:postgres@localhost:5432/apercura
# Connection used to apply migrations (needs DDL rights and CREATE EXTENSION).
# Falls back to DATABASE_URL when unset.
DATABASE_URL_MIGRATE=postgres://postgres:postgres@localhost:5432/apercura
# Optional: a separate, migrated database for the access-control integration tests
# (`bun run --cwd apps/web test`). They are skipped when unset.
# DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/apercura_test

# --- Authentication (Better Auth) ----------------------------------------------
# Random secret, at least 32 bytes (base64). Also encrypts TOTP secrets and
# backup codes: changing it locks every enrolled authenticator app out.
BETTER_AUTH_SECRET=
# Base URL Better Auth uses for callbacks, the request origin check and the
# passkey relying party (its hostname). Usually the same as APP_URL.
BETTER_AUTH_URL=http://localhost:3000

# --- Pro Santé Connect (practitioner sign-in, OpenID Connect) ------------------
PSC_CLIENT_ID=
PSC_CLIENT_SECRET=
# OIDC issuer URL (sandbox or production realm).
PSC_ISSUER=

# --- Application-level encryption ---------------------------------------------
# Comma-separated list of `<id>:<base64 32-byte key>` used to encrypt health data.
# Keep old keys in the list to decrypt existing data after a rotation.
ENCRYPTION_KEYS=
# Id of the key in ENCRYPTION_KEYS used to encrypt new data.
ENCRYPTION_ACTIVE_KEY=1
# base64 32-byte key for the HMAC blind indexes that make encrypted fields searchable.
BLIND_INDEX_KEY=

# --- Email ---------------------------------------------------------------------
# SMTP connection string. Mailpit (docker/compose.yml) listens on 1025, UI on http://localhost:8025.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Apercura <no-reply@localhost>"
# Mailpit API, read by the end-to-end tests to follow the confirmation link.
# MAILPIT_URL=http://localhost:8025

# --- Object storage (S3-compatible) -------------------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL the stored files are served from.
S3_PUBLIC_URL=

# --- Internal endpoints ---------------------------------------------------------
# Bearer token required by scheduled job endpoints.
JOBS_SECRET=
# Token required by the on-demand cache revalidation endpoint.
REVALIDATE_SECRET=
# HMAC key that turns client IPs into rate-limit keys (no raw IP stored); unset: random per process.
RATE_LIMIT_KEY=
# HMAC key that signs the booking form's ALTCHA challenges; unset: random per process.
ALTCHA_HMAC_KEY=
# Number of reverse proxies in front of the app, used to read the client IP from
# X-Forwarded-For (0 = trust none). Sign-in rate limits are keyed by this IP:
# with 0 in production, every client shares one bucket.
TRUSTED_PROXY_COUNT=0

# --- Hosting ---------------------------------------------------------------------
# Name of the HDS-certified host that runs this deployment (e.g. "Clever Cloud").
# Set it ONLY where health data really is hosted there: the home page then says so
# and names the host. Leave it empty for development, demos, forks and
# directory-only deployments; the page then only promises application-level
# encryption. Read at build time (the home page is prerendered).
PUBLIC_HDS_HOST=

# --- Map -------------------------------------------------------------------------
# MapLibre style URL (exposed to the browser). Any OpenMapTiles-schema style works;
# the app re-inks it with the booklet palette.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# --- Open data import (ETL) ------------------------------------------------------
# Comma-separated profession codes to import from the national directory
# (10 = physicians, 40 = dental surgeons, 50 = midwives). Code 99 is never imported.
ETL_PROFESSIONS=10,40,50,60
# Optional overrides of the source URLs (defaults: the stable data.gouv.fr links).
# ETL_ANS_URLS=personneActivite=https://…,savoirFaire=https://…,diplomes=https://…
# ETL_AMELI_URL=
# ETL_FINESS_DATASET_URL=
# ETL_GEOCODER_URL=https://data.geopf.fr/geocodage/search/csv
# Where downloads go (default: a temporary directory, removed after the run).
# ETL_WORK_DIR=

# --- Feature flags ---------------------------------------------------------------
# Enable online booking (true/false).
FEATURE_BOOKING=false
