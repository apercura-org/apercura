# Copy to `.env` at the repository root: cp .env.example .env
# Generate secrets with: bun run keys:generate

# --- Application ---------------------------------------------------------------
# Public base URL of the web app (used for links in emails, redirects, SEO).
APP_URL=http://localhost:3000

# --- Database (PostgreSQL + PostGIS) -----------------------------------------
# Runtime connection used by the web app (least-privileged role in production).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/apercura
# Connection used by the open data import (needs write access to the `directory` schema).
DATABASE_URL_ETL=postgres://postgres:postgres@localhost:5432/apercura
# Connection used to apply migrations (needs DDL rights and CREATE EXTENSION).
# Falls back to DATABASE_URL when unset.
DATABASE_URL_MIGRATE=postgres://postgres:postgres@localhost:5432/apercura

# --- Authentication (Better Auth) ----------------------------------------------
# Random secret, at least 32 bytes (base64).
BETTER_AUTH_SECRET=
# Base URL Better Auth uses for callbacks. Usually the same as APP_URL.
BETTER_AUTH_URL=http://localhost:3000

# --- Pro Santé Connect (practitioner sign-in, OpenID Connect) ------------------
PSC_CLIENT_ID=
PSC_CLIENT_SECRET=
# OIDC issuer URL (sandbox or production realm).
PSC_ISSUER=

# --- Application-level encryption ---------------------------------------------
# Comma-separated list of `<id>:<base64 32-byte key>` used to encrypt health data.
# Keep old keys in the list to decrypt existing data after a rotation.
ENCRYPTION_KEYS=
# Id of the key in ENCRYPTION_KEYS used to encrypt new data.
ENCRYPTION_ACTIVE_KEY=1
# base64 32-byte key for the HMAC blind indexes that make encrypted fields searchable.
BLIND_INDEX_KEY=

# --- Email ---------------------------------------------------------------------
# SMTP connection string. Mailpit (docker/compose.yml) listens on 1025, UI on http://localhost:8025.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Apercura <no-reply@localhost>"

# --- Object storage (S3-compatible) -------------------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL the stored files are served from.
S3_PUBLIC_URL=

# --- Internal endpoints ---------------------------------------------------------
# Bearer token required by scheduled job endpoints.
JOBS_SECRET=
# Token required by the on-demand cache revalidation endpoint.
REVALIDATE_SECRET=
# Number of reverse proxies in front of the app, used to read the client IP from
# X-Forwarded-For (0 = trust none).
TRUSTED_PROXY_COUNT=0

# --- Map -------------------------------------------------------------------------
# MapLibre style URL (exposed to the browser). Any OpenMapTiles-schema style works;
# the app re-inks it with the booklet palette.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# --- Open data import (ETL) ------------------------------------------------------
# Comma-separated profession codes to import from the national directory
# (10 = physicians, 40 = dental surgeons, 50 = pharmacists).
ETL_PROFESSIONS=10,40,50

# --- Feature flags ---------------------------------------------------------------
# Enable online booking (true/false).
FEATURE_BOOKING=false
